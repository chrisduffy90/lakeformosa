---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignupStrip from '../components/SignupStrip.astro';
---

<BaseLayout>
  <!-- HERO -->
  <header class="home-hero">
    <div class="home-hero-inner">
      <p class="home-hero-label">Orlando, Florida</p>
      <h1>Lake Formosa<br/>Neighborhood<br/>Association</h1>
      <p class="home-hero-sub">Advocating for neighbors, protecting the lake,<br/>and building community since the early 20th century.</p>
      <div class="home-hero-links">
        <a href="/events" class="text-link">Upcoming events →</a>
        <a href="/about" class="text-link">Our story →</a>
      </div>
    </div>
  </header>

  <!-- INTRO -->
  <section class="surface">
    <div class="section-inner">
      <div class="section-grid fade-in">
        <span class="section-label">Who We Are</span>
        <div class="section-body">
          <h2 class="section-heading">A neighborhood united by its lake</h2>
          <p>Lake Formosa sits at the edge of the Loch Haven Cultural Park, one of Orlando's most vibrant civic spaces. Our neighborhood wraps around it with craftsman bungalows, mid-century homes, and tree-lined streets that feel rare in central Florida.</p>
          <p>The association represents all residents. We engage with city hall, organize community events, maintain a neighborhood watch, and work to protect what makes this place worth living in.</p>
          <div class="info-box">
            <strong>General meetings</strong> are held twice a year and are open to the public — see the <a href="/events">event calendar</a> for the next date. All residents welcome. No membership required.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- UPCOMING EVENTS PREVIEW -->
  <section>
    <div class="section-inner">
      <div class="section-grid fade-in">
        <span class="section-label">Coming Up</span>
        <div>
          <h2 class="section-heading">What's happening soon</h2>
          <div id="home-event-list" class="event-list">
            <p class="loading-msg">Loading…</p>
          </div>
          <p style="margin-top: 1.5rem;"><a href="/events" class="text-link">Full calendar →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- SIGNUP -->
  <SignupStrip
    heading="Stay in the loop"
    subtext="Get event reminders and neighborhood news delivered to your inbox."
  />
</BaseLayout>

<script>
  import { apiFetch } from '../lib/api';

  type Evt = { id: string; title: string; date: string; time: string; location: string };

  function fmtMonth(d: string) {
    return new Date(d + 'T00:00:00').toLocaleString('en-US', { month: 'short' }).toUpperCase();
  }
  function fmtDay(d: string) {
    return new Date(d + 'T00:00:00').toLocaleString('en-US', { day: 'numeric' });
  }

  async function loadHomeEvents() {
    const list = document.getElementById('home-event-list')!;
    try {
      const res = await apiFetch('/events');
      const data = (await res.json() as Evt[]).slice(0, 3);
      if (data.length === 0) {
        list.innerHTML = '<p class="loading-msg">No upcoming events scheduled. Check back soon.</p>';
        return;
      }
      list.innerHTML = data.map(ev => `
        <div class="event-row">
          <div class="event-date-block">
            <div class="event-month">${fmtMonth(ev.date)}</div>
            <div class="event-day">${fmtDay(ev.date)}</div>
          </div>
          <div class="event-info">
            <h3>${ev.title}</h3>
            <p class="event-meta">${ev.time} · ${ev.location}</p>
          </div>
        </div>
      `).join('');
    } catch {
      list.innerHTML = '<p class="loading-msg" style="color:#b91c1c">Could not load events.</p>';
    }
  }

  loadHomeEvents();
</script>

<style>
  .home-hero {
    padding-top: var(--nav-height);
    min-height: 85vh;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border);
    background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/images/hero-bg-2.jpg');
    background-size: cover;
    background-position: center;
  }
  .home-hero-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 5rem 2.5rem 4.5rem;
    width: 100%;
  }
  .home-hero-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1.5rem;
  }
  .home-hero h1 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #fff;
  }
  .home-hero-sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.7;
    margin-bottom: 2.25rem;
    font-weight: 300;
  }
  .home-hero-links { display: flex; gap: 2rem; flex-wrap: wrap; }
  .home-hero-links .text-link {
    color: #fff;
    border-bottom-color: #fff;
  }

  @media (max-width: 480px) {
    .home-hero { min-height: auto; align-items: flex-start; }
    .home-hero-inner { padding: 1.5rem 1.25rem 3rem; }
    .home-hero-links { flex-direction: column; gap: 1rem; }
  }
</style>

<script is:inline>
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

  // Nudge-scroll on mobile so the scrollbar flashes briefly, hinting there's more content below.
  if (window.innerWidth <= 480 && document.documentElement.scrollHeight > window.innerHeight) {
    window.scrollTo(0, 1);
    setTimeout(() => window.scrollTo(0, 0), 300);
  }
</script>
