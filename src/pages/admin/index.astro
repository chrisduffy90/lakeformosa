---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin | Lake Formosa NA">
  <div class="page-hero">
    <div class="page-hero-inner">
      <h1>Board Admin</h1>
      <p id="admin-subtitle">Sign in to manage the neighborhood association website.</p>
    </div>
  </div>

  <!-- Login form -->
  <section id="login-section" class="surface" style="display:none">
    <div class="section-inner">
      <div class="login-wrap fade-in">
        <p class="login-desc">Enter your email address. If you're an authorized board member, we'll send you a sign-in link.</p>
        <form id="login-form" novalidate>
          <div class="email-field">
            <label for="email-input" class="sr-only">Email address</label>
            <input type="email" id="email-input" placeholder="your@email.com" autocomplete="email" required />
            <button type="submit" id="login-btn">Send link →</button>
          </div>
          <span class="field-error" id="login-error"></span>
        </form>
        <div id="sent-msg" class="sent-msg" style="display:none">
          Check your email — a sign-in link is on its way. It expires in 1 hour.
        </div>
      </div>
    </div>
  </section>

  <!-- Dashboard -->
  <section id="dashboard-section" class="surface" style="display:none">
    <div class="section-inner">
      <div class="admin-grid fade-in">
        <a href="/admin/board" class="admin-card">
          <span class="admin-card-icon">👤</span>
          <h2>Board Profiles</h2>
          <p>Update member bios, titles, emails, and headshots.</p>
          <span class="admin-card-link">Manage →</span>
        </a>
        <a href="/admin/events" class="admin-card">
          <span class="admin-card-icon">📅</span>
          <h2>Events</h2>
          <p>Add, edit, or remove upcoming neighborhood events.</p>
          <span class="admin-card-link">Manage →</span>
        </a>
        <a href="/admin/users" class="admin-card">
          <span class="admin-card-icon">🔑</span>
          <h2>Admin Users</h2>
          <p>Manage who can access the admin panel.</p>
          <span class="admin-card-link">Manage →</span>
        </a>
      </div>
      <div class="admin-footer fade-in">
        <button id="signout-btn" class="signout-btn">Sign out</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSessionId, getSessionName, clearSession, adminFetch, apiFetch } from '../../lib/api';

  async function checkSession(): Promise<boolean> {
    const id = getSessionId();
    if (!id) return false;
    try {
      const res = await adminFetch('/signups');
      return res.ok;
    } catch {
      return false;
    }
  }

  async function init() {
    const valid = await checkSession();
    if (valid) {
      showDashboard();
    } else {
      clearSession();
      showLogin();
    }
  }

  function showDashboard() {
    const name = getSessionName();
    document.getElementById('admin-subtitle')!.textContent = `Welcome back${name ? ', ' + name : ''}.`;
    document.getElementById('login-section')!.style.display = 'none';
    document.getElementById('dashboard-section')!.style.display = '';
  }

  function showLogin() {
    document.getElementById('login-section')!.style.display = '';
    document.getElementById('dashboard-section')!.style.display = 'none';
  }

  document.getElementById('login-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('email-input') as HTMLInputElement).value.trim();
    const btn = document.getElementById('login-btn') as HTMLButtonElement;
    const errEl = document.getElementById('login-error')!;
    const sentEl = document.getElementById('sent-msg')!;

    btn.textContent = 'Sending…';
    btn.disabled = true;
    errEl.textContent = '';

    try {
      const res = await apiFetch('/auth/request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (res.ok) {
        document.getElementById('login-form')!.style.display = 'none';
        sentEl.style.display = '';
      } else {
        errEl.textContent = 'Something went wrong. Please try again.';
        btn.textContent = 'Send link →';
        btn.disabled = false;
      }
    } catch {
      errEl.textContent = 'Something went wrong. Please try again.';
      btn.textContent = 'Send link →';
      btn.disabled = false;
    }
  });

  document.getElementById('signout-btn')!.addEventListener('click', async () => {
    await adminFetch('/auth/session', { method: 'DELETE' });
    clearSession();
    showLogin();
    document.getElementById('admin-subtitle')!.textContent = 'Sign in to manage the neighborhood association website.';
    document.getElementById('login-form')!.style.display = '';
    document.getElementById('sent-msg')!.style.display = 'none';
    (document.getElementById('email-input') as HTMLInputElement).value = '';
    document.getElementById('login-btn')!.textContent = 'Send link →';
    (document.getElementById('login-btn') as HTMLButtonElement).disabled = false;
  });

  init();
</script>

<script is:inline>
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>

<style>
  .login-wrap { max-width: 480px; }

  .login-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .email-field {
    display: flex;
    border: 1px solid var(--border);
  }

  .email-field input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    background: transparent;
    outline: none;
    color: var(--text-primary);
  }

  .email-field button {
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 0.75rem 1.25rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .email-field button:hover { opacity: 0.85; }
  .email-field button:disabled { opacity: 0.5; cursor: not-allowed; }

  .field-error {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: #b91c1c;
    min-height: 1.2em;
  }

  .sent-msg {
    padding: 1rem 1.25rem;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .admin-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .admin-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2rem 1.75rem;
    background: white;
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .admin-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    text-decoration: none;
  }

  .admin-card-icon { font-size: 1.5rem; margin-bottom: 0.25rem; }

  .admin-card h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0;
  }

  .admin-card p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .admin-card-link {
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .admin-footer { padding-top: 1rem; border-top: 1px solid var(--border); }

  .signout-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 0.5rem 1.25rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .signout-btn:hover { border-color: var(--text-primary); color: var(--text-primary); }

  @media (max-width: 768px) {
    .admin-grid { grid-template-columns: 1fr; }
  }
</style>
