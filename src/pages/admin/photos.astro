---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Photo Gallery — Admin | Lake Formosa NA">
  <div class="page-hero">
    <div class="page-hero-inner">
      <h1>Photo Gallery</h1>
      <p><a href="/admin" style="color:inherit;opacity:0.7;font-size:0.85rem">← Back to admin</a></p>
    </div>
  </div>

  <section class="surface">
    <div class="section-inner">
      <div id="queue-list" class="queue-list fade-in">
        <p class="loading-msg">Loading…</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSessionId, adminFetch } from '../../lib/api';

  type Photo = {
    id: string; url: string; caption: string | null;
    submitted_by: string | null; submitted_email: string | null;
    status: string; created_at: string;
  };

  if (!getSessionId()) window.location.href = '/admin';

  async function loadQueue() {
    const listEl = document.getElementById('queue-list')!;
    try {
      const res = await adminFetch('/gallery-photos/queue');
      const photos = await res.json() as Photo[];
      if (!photos.length) {
        listEl.innerHTML = '<p class="loading-msg">No photos waiting for review.</p>';
        return;
      }
      listEl.innerHTML = photos.map(p => `
        <div class="queue-row" data-id="${p.id}">
          <div class="queue-thumb"><img src="${p.url}" alt="${esc(p.caption ?? 'Submitted photo')}" loading="lazy" /></div>
          <div class="queue-info">
            ${p.caption ? `<p class="queue-caption">${esc(p.caption)}</p>` : '<p class="queue-caption queue-caption-empty">No caption</p>'}
            <span class="queue-meta">
              ${p.submitted_by ? esc(p.submitted_by) : 'Anonymous'}${p.submitted_email ? ` · ${esc(p.submitted_email)}` : ''}
              · ${new Date(p.created_at).toLocaleDateString()}
            </span>
            <span class="queue-status queue-status-${p.status}">${p.status}</span>
          </div>
          <div class="queue-actions">
            ${p.status !== 'approved' ? `<button class="btn-approve" data-id="${p.id}">Approve</button>` : ''}
            ${p.status !== 'rejected' ? `<button class="btn-reject" data-id="${p.id}">Reject</button>` : ''}
            <button class="btn-delete" data-id="${p.id}">Delete</button>
          </div>
        </div>
      `).join('');

      listEl.querySelectorAll<HTMLButtonElement>('.btn-approve').forEach(btn => {
        btn.addEventListener('click', () => setStatus(btn.dataset.id!, 'approved'));
      });
      listEl.querySelectorAll<HTMLButtonElement>('.btn-reject').forEach(btn => {
        btn.addEventListener('click', () => setStatus(btn.dataset.id!, 'rejected'));
      });
      listEl.querySelectorAll<HTMLButtonElement>('.btn-delete').forEach(btn => {
        btn.addEventListener('click', () => deletePhoto(btn.dataset.id!));
      });
    } catch {
      listEl.innerHTML = '<p class="loading-msg" style="color:#b91c1c">Failed to load photos.</p>';
    }
  }

  async function setStatus(id: string, status: 'approved' | 'rejected') {
    try {
      const res = await adminFetch(`/gallery-photos/${id}`, { method: 'PUT', body: JSON.stringify({ status }) });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}) as { error?: string });
        alert(data.error ?? `Failed to update photo (HTTP ${res.status}). Please try again.`);
        return;
      }
    } catch {
      alert('Failed to update photo. Please check your connection and try again.');
      return;
    }
    loadQueue();
  }

  async function deletePhoto(id: string) {
    if (!confirm('Delete this photo? This cannot be undone.')) return;
    try {
      const res = await adminFetch(`/gallery-photos/${id}`, { method: 'DELETE' });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}) as { error?: string });
        alert(data.error ?? `Failed to delete photo (HTTP ${res.status}). Please try again.`);
        return;
      }
    } catch {
      alert('Failed to delete photo. Please check your connection and try again.');
      return;
    }
    loadQueue();
  }

  function esc(str: string) {
    return str.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  loadQueue();
</script>

<script is:inline>
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>

<style>
  .queue-list { display: flex; flex-direction: column; gap: 0.5rem; }

  .queue-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    background: white;
  }

  .queue-thumb {
    width: 72px; height: 72px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--bg);
  }
  .queue-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .queue-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .queue-caption { font-size: 0.9rem; color: var(--text-primary); }
  .queue-caption-empty { color: var(--text-secondary); font-style: italic; }
  .queue-meta { font-size: 0.78rem; color: var(--text-secondary); }

  .queue-status {
    align-self: flex-start;
    margin-top: 0.15rem;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }
  .queue-status-pending { background: #fef9c3; color: #854d0e; }
  .queue-status-approved { background: #dcfce7; color: #166534; }
  .queue-status-rejected { background: #fee2e2; color: #991b1b; }

  .queue-actions { display: flex; gap: 0.5rem; flex-shrink: 0; }

  .btn-approve, .btn-reject, .btn-delete {
    padding: 0.35rem 0.8rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    cursor: pointer;
    border-radius: 2px;
    white-space: nowrap;
    background: none;
  }
  .btn-approve { border: 1px solid var(--accent); color: var(--accent); }
  .btn-approve:hover { background: var(--accent-light); }
  .btn-reject { border: 1px solid var(--border); color: var(--text-secondary); }
  .btn-reject:hover { border-color: var(--text-primary); color: var(--text-primary); }
  .btn-delete { border: 1px solid #fca5a5; color: #b91c1c; }
  .btn-delete:hover { background: #fef2f2; }

  .loading-msg { font-size: 0.9rem; color: var(--text-secondary); }

  @media (max-width: 600px) {
    .queue-row { flex-wrap: wrap; }
    .queue-actions { width: 100%; justify-content: flex-end; }
  }
</style>
