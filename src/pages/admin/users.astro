---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin Users | Lake Formosa NA">
  <div class="page-hero">
    <div class="page-hero-inner">
      <h1>Admin Users</h1>
      <p><a href="/admin" style="color:inherit;opacity:0.7;font-size:0.85rem">← Back to admin</a></p>
    </div>
  </div>

  <section class="surface">
    <div class="section-inner">
      <div id="users-list" class="users-list fade-in">
        <p class="loading-msg">Loading…</p>
      </div>
    </div>
  </section>

  <section>
    <div class="section-inner">
      <div class="add-section fade-in">
        <h2 class="section-heading">Add an admin user</h2>
        <p class="add-desc">The person will receive a magic link email when they sign in. Their email must be entered exactly as they'll type it.</p>
        <form id="add-form" novalidate>
          <div class="form-row-2">
            <div class="form-field">
              <label>Name</label>
              <input type="text" name="name" placeholder="e.g. Teresa Safon" />
            </div>
            <div class="form-field">
              <label>Email *</label>
              <input type="email" name="email" required />
            </div>
          </div>
          <span class="field-error" id="add-error"></span>
          <button type="submit" id="add-btn">Add User →</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSessionId, clearSession, adminFetch } from '../../lib/api';

  if (!getSessionId()) window.location.href = '/admin';

  type AdminUser = { email: string; name: string; created_at: string };

  function fmtDate(d: string) {
    return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  async function loadUsers() {
    const listEl = document.getElementById('users-list')!;
    try {
      const res = await adminFetch('/admin-users');
      if (res.status === 401) { clearSession(); window.location.href = '/admin'; return; }
      const users = await res.json() as AdminUser[];
      if (!users.length) {
        listEl.innerHTML = '<p class="loading-msg">No admin users found.</p>';
        return;
      }
      listEl.innerHTML = users.map(u => `
        <div class="user-row">
          <div class="user-info">
            <strong>${u.name || '—'}</strong>
            <span class="user-email">${u.email}</span>
            <span class="user-date">Added ${fmtDate(u.created_at)}</span>
          </div>
          <button class="btn-remove" data-email="${u.email}">Remove</button>
        </div>
      `).join('');

      listEl.querySelectorAll<HTMLButtonElement>('.btn-remove').forEach(btn => {
        btn.addEventListener('click', () => removeUser(btn.dataset.email!));
      });
    } catch {
      listEl.innerHTML = '<p class="loading-msg" style="color:#b91c1c">Failed to load users.</p>';
    }
  }

  async function removeUser(email: string) {
    if (!confirm(`Remove ${email} from admin access?`)) return;
    await adminFetch(`/admin-users/${encodeURIComponent(email)}`, { method: 'DELETE' });
    loadUsers();
  }

  document.getElementById('add-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);
    const email = (fd.get('email') as string).trim();
    const name = (fd.get('name') as string).trim();
    const btn = document.getElementById('add-btn') as HTMLButtonElement;
    const errEl = document.getElementById('add-error')!;

    btn.textContent = 'Adding…'; btn.disabled = true; errEl.textContent = '';

    const res = await adminFetch('/admin-users', {
      method: 'POST',
      body: JSON.stringify({ email, name }),
    });

    if (res.ok) {
      (e.target as HTMLFormElement).reset();
      loadUsers();
    } else {
      errEl.textContent = 'Could not add user. Check the email and try again.';
    }
    btn.textContent = 'Add User →'; btn.disabled = false;
  });

  loadUsers();
</script>

<script is:inline>
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>

<style>
  .users-list { display: flex; flex-direction: column; gap: 0.75rem; }

  .user-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--border);
    background: white;
  }

  .user-info { display: flex; flex-direction: column; gap: 0.2rem; }
  .user-info strong { font-size: 0.95rem; color: var(--text-primary); }
  .user-email { font-size: 0.85rem; color: var(--text-secondary); }
  .user-date { font-size: 0.78rem; color: var(--text-secondary); opacity: 0.7; }

  .btn-remove {
    padding: 0.4rem 0.9rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    cursor: pointer;
    background: none;
    border: 1px solid #fca5a5;
    color: #b91c1c;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .btn-remove:hover { background: #fef2f2; }

  .add-section { max-width: 600px; }

  .section-heading {
    font-family: 'DM Serif Display', serif;
    font-size: 1.4rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .add-desc {
    font-size: 0.87rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  #add-form { display: flex; flex-direction: column; gap: 1rem; }

  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  .form-field { display: flex; flex-direction: column; gap: 0.35rem; }

  .form-field label {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .form-field input {
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    background: white;
    color: var(--text-primary);
    outline: none;
  }

  .form-field input:focus { border-color: var(--accent); }

  .field-error { display: block; font-size: 0.82rem; color: #b91c1c; min-height: 1.2em; }

  #add-form > button[type=submit] {
    align-self: flex-start;
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 0.7rem 1.4rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  #add-form > button[type=submit]:hover { opacity: 0.85; }
  #add-form > button[type=submit]:disabled { opacity: 0.5; cursor: not-allowed; }

  .loading-msg { font-size: 0.9rem; color: var(--text-secondary); }

  @media (max-width: 600px) {
    .user-row { flex-direction: column; align-items: flex-start; }
    .form-row-2 { grid-template-columns: 1fr; }
  }
</style>
