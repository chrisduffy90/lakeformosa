---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Gallery | Lake Formosa Neighborhood Association">
  <div class="page-hero">
    <div class="page-hero-inner">
      <h1>Neighborhood Gallery</h1>
      <p>Photos of Lake Formosa, Loch Haven Park, and the community events that bring us together.</p>
    </div>
  </div>

  <section class="surface">
    <div class="section-inner">
      <div class="section-grid fade-in">
        <span class="section-label">Photos</span>
        <div>
          <div id="gallery-grid" class="gallery-grid">
            <!-- Placeholder skeleton while loading -->
            {Array.from({ length: 9 }).map((_, i) => (
              <div class="gallery-cell">
                <div class="gallery-placeholder">
                  <span class="gallery-placeholder-icon">◻</span>
                  <span>Photo {i + 1}</span>
                </div>
              </div>
            ))}
          </div>
          <p id="gallery-empty" style="display:none;font-size:0.9rem;color:var(--text-secondary);line-height:1.7;margin-top:1rem">
            Photos coming soon. Be the first to submit one below.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div id="photo-modal" class="photo-modal-overlay" style="display:none" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button type="button" class="photo-modal-close" id="photo-modal-close" aria-label="Close">✕</button>
    <button type="button" class="photo-modal-nav photo-modal-prev" id="photo-modal-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="photo-modal-nav photo-modal-next" id="photo-modal-next" aria-label="Next photo">›</button>
    <div class="photo-modal-content">
      <img id="photo-modal-img" src="" alt="" />
      <div class="photo-modal-info">
        <p class="photo-modal-caption" id="photo-modal-caption" style="display:none"></p>
        <span class="photo-modal-meta" id="photo-modal-meta"></span>
      </div>
    </div>
  </div>

  <section>
    <div class="section-inner">
      <div class="section-grid fade-in">
        <span class="section-label">Submit</span>
        <div class="section-body">
          <h2 class="section-heading">Share your photos</h2>
          <p>Have a great shot of the lake, the park, or a neighborhood event? Submit it here and it will appear in the gallery after board review.</p>

          <form id="photo-form" class="photo-submit-form" novalidate>
            <div class="photo-field">
              <label for="photo-file">Photo <span class="required">*</span></label>
              <input type="file" id="photo-file" name="photo" accept="image/*" required />
            </div>
            <div class="photo-field">
              <label for="photo-caption">Caption <span class="hint">(optional)</span></label>
              <input type="text" id="photo-caption" name="caption" placeholder="e.g. Sunset over Lake Formosa, May 2025" maxlength="200" />
            </div>
            <div class="form-row-2">
              <div class="photo-field">
                <label for="photo-name">Your name <span class="hint">(optional)</span></label>
                <input type="text" id="photo-name" name="submitted_by" maxlength="100" />
              </div>
              <div class="photo-field">
                <label for="photo-email">Your email <span class="hint">(optional)</span></label>
                <input type="email" id="photo-email" name="submitted_email" />
              </div>
            </div>
            <div class="cf-turnstile" data-sitekey="0x4AAAAAADvkhzUwswwSTwtR" data-action="turnstile-spin-v1"></div>
            <span class="field-error" id="photo-error"></span>
            <button type="submit" id="photo-btn">Submit photo →</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { apiFetch } from '../lib/api';

  type Photo = { id: string; url: string; caption?: string; submitted_by?: string; created_at: string };

  let photos: Photo[] = [];
  let currentIndex = -1;

  async function loadGallery() {
    const grid = document.getElementById('gallery-grid')!;
    const emptyMsg = document.getElementById('gallery-empty')!;

    try {
      const res = await apiFetch('/gallery-photos');
      const data = await res.json() as Photo[];

      if (!res.ok || !data.length) {
        grid.style.display = 'none';
        emptyMsg.style.display = '';
        return;
      }

      photos = data;

      grid.innerHTML = data.map((p, i) => `
        <div class="gallery-cell" data-index="${i}">
          <img src="${p.url}" alt="${p.caption ?? 'Neighborhood photo'}" loading="lazy" />
          ${p.caption ? `<p class="gallery-caption">${p.caption}</p>` : ''}
        </div>
      `).join('');

      grid.querySelectorAll<HTMLElement>('.gallery-cell').forEach(cell => {
        cell.addEventListener('click', () => openModal(Number(cell.dataset.index)));
      });
    } catch {
      grid.style.display = 'none';
      emptyMsg.style.display = '';
    }
  }

  // Photo modal
  const modal = document.getElementById('photo-modal')!;
  const modalImg = document.getElementById('photo-modal-img') as HTMLImageElement;
  const modalCaption = document.getElementById('photo-modal-caption')!;
  const modalMeta = document.getElementById('photo-modal-meta')!;

  function renderModal() {
    const p = photos[currentIndex];
    modalImg.src = p.url;
    modalImg.alt = p.caption ?? 'Neighborhood photo';

    if (p.caption) {
      modalCaption.textContent = p.caption;
      modalCaption.style.display = '';
    } else {
      modalCaption.style.display = 'none';
    }

    const date = new Date(p.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
    modalMeta.textContent = [p.submitted_by ? `Photo by ${p.submitted_by}` : null, date].filter(Boolean).join(' · ');
  }

  function openModal(index: number) {
    currentIndex = index;
    renderModal();
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  function showPrev() {
    currentIndex = (currentIndex - 1 + photos.length) % photos.length;
    renderModal();
  }

  function showNext() {
    currentIndex = (currentIndex + 1) % photos.length;
    renderModal();
  }

  document.getElementById('photo-modal-close')!.addEventListener('click', closeModal);
  document.getElementById('photo-modal-prev')!.addEventListener('click', showPrev);
  document.getElementById('photo-modal-next')!.addEventListener('click', showNext);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  document.addEventListener('keydown', (e) => {
    if (modal.style.display === 'none') return;
    if (e.key === 'Escape') closeModal();
    else if (e.key === 'ArrowLeft') showPrev();
    else if (e.key === 'ArrowRight') showNext();
  });

  // Photo submission form
  const form = document.getElementById('photo-form') as HTMLFormElement;
  const btn = document.getElementById('photo-btn') as HTMLButtonElement;
  const errEl = document.getElementById('photo-error')!;

  declare const turnstile: {
    getResponse: (el?: HTMLElement | string) => string;
    reset: (el?: HTMLElement | string) => void;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.textContent = '';

    const fileInput = document.getElementById('photo-file') as HTMLInputElement;
    const file = fileInput.files?.[0];
    if (!file) { errEl.textContent = 'Please select a photo to upload.'; return; }

    const maxMB = 10;
    if (file.size > maxMB * 1024 * 1024) {
      errEl.textContent = `Photo must be under ${maxMB} MB.`; return;
    }

    const turnstileToken = typeof turnstile !== 'undefined' ? turnstile.getResponse() : '';
    if (!turnstileToken) { errEl.textContent = 'Please complete the verification challenge.'; return; }

    btn.textContent = 'Uploading…'; btn.disabled = true;

    const fd = new FormData();
    fd.append('file', file);
    fd.append('turnstile_token', turnstileToken);
    const caption = (document.getElementById('photo-caption') as HTMLInputElement).value.trim();
    const submittedBy = (document.getElementById('photo-name') as HTMLInputElement).value.trim();
    const submittedEmail = (document.getElementById('photo-email') as HTMLInputElement).value.trim();
    if (caption) fd.append('caption', caption);
    if (submittedBy) fd.append('submitted_by', submittedBy);
    if (submittedEmail) fd.append('submitted_email', submittedEmail);

    try {
      const res = await apiFetch('/gallery-photos', { method: 'POST', body: fd });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}) as { error?: string });
        errEl.textContent = data.error ?? 'Upload failed. Please try again.';
        btn.textContent = 'Submit photo →'; btn.disabled = false;
        if (typeof turnstile !== 'undefined') turnstile.reset();
        return;
      }
    } catch {
      errEl.textContent = 'Upload failed. Please try again.';
      btn.textContent = 'Submit photo →'; btn.disabled = false;
      if (typeof turnstile !== 'undefined') turnstile.reset();
      return;
    }

    form.reset();
    if (typeof turnstile !== 'undefined') turnstile.reset();

    let successMsg = document.querySelector('.submit-success') as HTMLElement | null;
    if (!successMsg) {
      successMsg = document.createElement('p');
      successMsg.className = 'submit-success';
      form.after(successMsg);
    }
    successMsg.textContent = 'Thank you! Your photo will appear in the gallery after board review.';

    btn.textContent = 'Submitted ✓';
    setTimeout(() => {
      btn.textContent = 'Submit photo →';
      btn.disabled = false;
    }, 1500);
  });

  loadGallery();
</script>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script is:inline>
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>

<style>
  .gallery-grid {
    columns: 3;
    column-gap: 0.75rem;
  }

  .gallery-cell {
    break-inside: avoid;
    margin-bottom: 0.75rem;
    overflow: hidden;
    background: var(--border);
    position: relative;
    cursor: pointer;
  }

  .gallery-cell img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease, filter 0.2s ease;
  }

  .gallery-cell:hover img { transform: scale(1.03); filter: brightness(0.92); }

  .gallery-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0,0,0,0.55);
    color: white;
    font-size: 0.75rem;
    padding: 0.4rem 0.6rem;
    margin: 0;
    line-height: 1.4;
  }

  .gallery-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background: var(--surface);
    color: var(--text-secondary);
    font-size: 0.78rem;
  }

  .gallery-placeholder-icon { font-size: 1.25rem; opacity: 0.4; }

  /* Photo modal */
  .photo-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 8, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 3rem 1.5rem;
  }

  .photo-modal-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: min(900px, 100%);
    max-height: 100%;
  }

  .photo-modal-content img {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    display: block;
  }

  .photo-modal-info {
    text-align: center;
    margin-top: 1rem;
    max-width: 560px;
  }

  .photo-modal-caption {
    color: #fff;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0.35rem;
  }

  .photo-modal-meta {
    display: block;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .photo-modal-close,
  .photo-modal-nav {
    position: fixed;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .photo-modal-close:hover,
  .photo-modal-nav:hover { background: rgba(0, 0, 0, 0.75); }

  .photo-modal-close {
    top: 1.25rem;
    right: 1.25rem;
    width: 40px;
    height: 40px;
    font-size: 1rem;
  }

  .photo-modal-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    font-size: 1.6rem;
    line-height: 1;
  }

  .photo-modal-prev { left: 1.25rem; }
  .photo-modal-next { right: 1.25rem; }

  @media (max-width: 640px) {
    .photo-modal-nav { width: 40px; height: 40px; font-size: 1.3rem; }
    .photo-modal-prev { left: 0.5rem; }
    .photo-modal-next { right: 0.5rem; }
    .photo-modal-close { top: 0.75rem; right: 0.75rem; }
  }

  /* Photo submit form */
  .photo-submit-form { display: flex; flex-direction: column; gap: 1rem; max-width: 520px; }

  .photo-field { display: flex; flex-direction: column; gap: 0.3rem; }

  .photo-field label {
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .required { color: var(--accent); }
  .hint { text-transform: none; letter-spacing: 0; font-size: 0.65rem; opacity: 0.75; }

  .photo-field input[type="text"],
  .photo-field input[type="email"] {
    width: 100%;
    background: rgba(255,255,255,0.7);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.65rem 0.85rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 300;
    outline: none;
    transition: border-color 0.2s;
  }

  .photo-field input[type="text"]:focus,
  .photo-field input[type="email"]:focus { border-color: var(--accent); }

  .photo-field input[type="file"] {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  button[type="submit"] {
    align-self: flex-start;
    background: var(--text-primary);
    color: var(--bg);
    border: none;
    padding: 0.8rem 1.75rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: opacity 0.2s;
    margin-top: 0.5rem;
  }

  button[type="submit"]:hover { opacity: 0.8; }
  button[type="submit"]:disabled { opacity: 0.5; cursor: not-allowed; }

  .submit-success {
    font-size: 0.9rem;
    color: var(--accent);
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  @media (max-width: 780px) {
    .gallery-grid { columns: 2; }
  }

  @media (max-width: 600px) {
    .form-row-2 { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .gallery-grid { columns: 1; }
  }
</style>
