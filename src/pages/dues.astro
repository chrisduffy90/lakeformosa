---
import BaseLayout from '../layouts/BaseLayout.astro';

const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<BaseLayout title="Dues & Donations | Lake Formosa Neighborhood Association">
  <div class="page-hero">
    <div class="page-hero-inner">
      <h1>Dues &amp; Donations</h1>
      <p>Annual dues support association operations, community events, and neighborhood advocacy.</p>
    </div>
  </div>

  <!-- DUES PAYMENT -->
  <section class="surface">
    <div class="section-inner">
      <div class="section-grid fade-in">
        <span class="section-label">Annual Dues</span>
        <div>
          <div class="info-box" id="payment-success-banner" style="display:none; border-left-color:#16a34a; margin-bottom:1.75rem">
            <strong>Thank you!</strong> Your payment was received. A confirmation has been sent to your email.
          </div>
          <div class="info-box" id="payment-canceled-banner" style="display:none; margin-bottom:1.75rem">
            Payment was canceled — no charge was made. You can try again below.
          </div>
          <h2 class="section-heading">Support your neighborhood association</h2>
          <p style="font-size:0.9rem;color:var(--text-secondary);line-height:1.7;margin-bottom:2rem;">
            Membership dues: <strong style="color:var(--text-primary)">$20 per household per year</strong>, due by January 31st. Dues-paying members are eligible to vote in board elections and on matters brought to the general membership.
          </p>

          <!-- DONATION SELECTOR -->
          <div class="donation-card">
            <div class="donation-header">
              <span class="donation-label">Choose an amount</span>
            </div>
            <div class="amount-options">
              <button class="amount-btn active" data-amount="20">
                <span class="amount-value">$20</span>
                <span class="amount-tag">Dues</span>
              </button>
              <button class="amount-btn" data-amount="50">
                <span class="amount-value">$50</span>
                <span class="amount-tag">Supporter</span>
              </button>
              <button class="amount-btn" data-amount="100">
                <span class="amount-value">$100</span>
                <span class="amount-tag">Advocate</span>
              </button>
              <button class="amount-btn custom-toggle" data-amount="custom">
                <span class="amount-value">Other</span>
                <span class="amount-tag">Custom</span>
              </button>
            </div>

            <div class="custom-amount-wrap" id="custom-amount-wrap" style="display:none">
              <label for="custom-amount" class="sr-only">Custom amount</label>
              <div class="custom-input-group">
                <span class="currency-prefix">$</span>
                <input
                  type="number"
                  id="custom-amount"
                  min="1"
                  step="1"
                  placeholder="Enter amount"
                  class="custom-input"
                />
              </div>
            </div>

            <div class="donation-cta-wrap">
              <button class="donate-btn" id="donate-btn">
                Pay <span id="selected-amount">$20</span> →
              </button>
              <span class="field-error" id="donate-error"></span>
              <p class="donate-note">
                You'll be redirected to Stripe to complete your payment securely.
              </p>
            </div>
          </div>

          <div class="info-box" style="margin-top:2rem">
            <strong>Paying by check or cash in the meantime?</strong> Bring payment to a general meeting, made out to <em>Lake Formosa Neighborhood Association</em>. You can also <a href="/contact">contact the treasurer</a> to arrange payment by mail.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT DUES COVER -->
  <section>
    <div class="section-inner">
      <div class="section-grid fade-in">
        <span class="section-label">What It Covers</span>
        <div class="section-body">
          <h2 class="section-heading">Where your money goes</h2>
          <p>Annual dues keep the association running — covering meeting costs, printed communications, website maintenance, and community events throughout the year.</p>
          <p>Additional donations above the $20 dues support larger neighborhood initiatives: advocacy campaigns, park improvements, beautification projects, and community events that go beyond our operating budget.</p>
          <div class="use-grid">
            <div class="use-item">
              <span class="use-icon">🏛️</span>
              <div>
                <strong>General meetings</strong>
                <p>Venue, materials, and communications for our two general meetings each year.</p>
              </div>
            </div>
            <div class="use-item">
              <span class="use-icon">📣</span>
              <div>
                <strong>Advocacy</strong>
                <p>Legal notices, city hall appearances, and outreach for zoning and development issues.</p>
              </div>
            </div>
            <div class="use-item">
              <span class="use-icon">🌳</span>
              <div>
                <strong>Neighborhood projects</strong>
                <p>Cleanup events, beautification, and stewardship of Lake Formosa and its shoreline.</p>
              </div>
            </div>
            <div class="use-item">
              <span class="use-icon">🎉</span>
              <div>
                <strong>Community events</strong>
                <p>Block parties, holiday gatherings, and events that build connections between neighbors.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUESTIONS -->
  <section class="surface">
    <div class="section-inner">
      <div class="section-grid fade-in">
        <span class="section-label">Questions</span>
        <div class="section-body">
          <h2 class="section-heading">Membership questions</h2>
          <p>Questions about your membership status, payment history, or how to update your contact information? Get in touch and the treasurer will follow up.</p>
          <p><a href="/contact" class="text-link">Contact the treasurer →</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ apiUrl }}>
  // Payment redirect banner
  const params = new URLSearchParams(window.location.search);
  if (params.get('success') === 'true') {
    document.getElementById('payment-success-banner').style.display = '';
  } else if (params.get('canceled') === 'true') {
    document.getElementById('payment-canceled-banner').style.display = '';
  }

  // Amount selector
  const btns = document.querySelectorAll('.amount-btn');
  const selectedLabel = document.getElementById('selected-amount');
  const customWrap = document.getElementById('custom-amount-wrap');
  const customInput = document.getElementById('custom-amount');
  const donateBtn = document.getElementById('donate-btn');
  const donateError = document.getElementById('donate-error');
  let currentAmount = 20;
  let isCustom = false;

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const val = btn.dataset.amount;
      if (val === 'custom') {
        isCustom = true;
        customWrap.style.display = '';
        customInput.focus();
        selectedLabel.textContent = customInput.value ? `$${customInput.value}` : '$—';
      } else {
        isCustom = false;
        customWrap.style.display = 'none';
        currentAmount = parseInt(val);
        selectedLabel.textContent = `$${val}`;
      }
    });
  });

  customInput?.addEventListener('input', () => {
    const v = parseFloat(customInput.value);
    selectedLabel.textContent = v > 0 ? `$${Math.floor(v)}` : '$—';
  });

  donateBtn.addEventListener('click', async () => {
    const amount = isCustom ? Math.floor(parseFloat(customInput.value)) : currentAmount;
    donateError.textContent = '';

    if (!amount || amount < 1) {
      donateError.textContent = 'Please enter a valid amount.';
      return;
    }

    const originalLabel = donateBtn.innerHTML;
    donateBtn.disabled = true;
    donateBtn.textContent = 'Redirecting...';

    try {
      const res = await fetch(`${apiUrl}/create-checkout-session`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount }),
      });
      if (!res.ok) throw new Error();
      const data = await res.json();
      window.location.href = data.url;
    } catch {
      donateError.textContent = 'Something went wrong. Please try again or contact the treasurer.';
      donateBtn.disabled = false;
      donateBtn.innerHTML = originalLabel;
    }
  });

  // Fade-in observer
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* ── DONATION CARD ── */
  .donation-card {
    background: white;
    border: 1px solid var(--border);
    padding: 2rem;
    max-width: 520px;
  }

  .donation-header { margin-bottom: 1.25rem; }

  .donation-label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-weight: 400;
  }

  /* ── AMOUNT GRID ── */
  .amount-options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .amount-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.85rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    font-family: 'DM Sans', sans-serif;
  }

  .amount-btn:hover {
    border-color: var(--accent);
  }

  .amount-btn.active {
    border-color: var(--accent);
    background: #eef2f0;
  }

  .amount-value {
    font-family: 'DM Serif Display', serif;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-primary);
  }

  .amount-tag {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .amount-btn.active .amount-tag { color: var(--accent); }

  /* ── CUSTOM INPUT ── */
  .custom-amount-wrap { margin-bottom: 1.25rem; }

  .custom-input-group {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.7);
    transition: border-color 0.2s;
  }

  .custom-input-group:focus-within { border-color: var(--accent); }

  .currency-prefix {
    padding: 0 0.75rem;
    font-family: 'DM Serif Display', serif;
    font-size: 1.1rem;
    color: var(--text-secondary);
    border-right: 1px solid var(--border);
    user-select: none;
  }

  .custom-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    padding: 0.7rem 0.85rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: var(--text-primary);
    font-weight: 300;
  }

  /* ── DONATE CTA ── */
  .donation-cta-wrap { margin-top: 0.25rem; }

  .donate-btn {
    width: 100%;
    background: var(--accent);
    color: white;
    border: none;
    padding: 0.9rem 1.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: opacity 0.2s;
    position: relative;
  }

  .donate-btn:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .donate-note {
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin-top: 0.65rem;
    line-height: 1.5;
    font-style: italic;
  }

  /* ── USE GRID ── */
  .use-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .use-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .use-icon { font-size: 1.25rem; flex-shrink: 0; margin-top: 0.1rem; }

  .use-item strong {
    display: block;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--text-primary);
    margin-bottom: 0.3rem;
  }

  .use-item p {
    font-size: 0.83rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 600px) {
    .amount-options { grid-template-columns: repeat(2, 1fr); }
    .use-grid { grid-template-columns: 1fr; }
  }
</style>
