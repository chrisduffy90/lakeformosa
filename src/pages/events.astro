---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignupStrip from '../components/SignupStrip.astro';
---

<BaseLayout title="Events | Lake Formosa Neighborhood Association">
  <div class="page-hero">
    <div class="page-hero-inner">
      <h1>Events &amp; Meetings</h1>
      <p>Everything coming up in the neighborhood: meetings, cleanups, and community gatherings.</p>
    </div>
  </div>

  <section class="surface">
    <div class="section-inner">
      <div class="section-grid fade-in">
        <span class="section-label">Calendar</span>
        <div>
          <h2 class="section-heading">Upcoming events</h2>
          <div id="event-list" class="event-list">
            <p class="loading-msg">Loading events…</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-inner">
      <div class="section-grid fade-in">
        <span class="section-label">Standing</span>
        <div class="section-body">
          <h2 class="section-heading">Regular meetings</h2>
          <p><strong style="font-weight: 500; color: var(--text-primary);">General meetings</strong> are held twice a year and are open to the public. No membership required to attend — see the calendar above for the next date.</p>
          <div class="info-box">
            <strong>Have an event to add?</strong> If you're organizing a neighborhood activity, <a href="/contact">send us the details</a> and we'll list it here.
          </div>
        </div>
      </div>
    </div>
  </section>

  <SignupStrip
    heading="Never miss an event"
    subtext="Sign up and we'll send you reminders before every meeting, cleanup, and community gathering."
  />
</BaseLayout>

<script>
  import { apiFetch } from '../lib/api';

  type Evt = { id: string; title: string; date: string; time: string; location: string; description: string };

  function fmtMonth(d: string) {
    return new Date(d + 'T00:00:00').toLocaleString('en-US', { month: 'short' }).toUpperCase();
  }
  function fmtDay(d: string) {
    return new Date(d + 'T00:00:00').toLocaleString('en-US', { day: 'numeric' });
  }

  async function loadEvents() {
    const list = document.getElementById('event-list')!;
    try {
      const res = await apiFetch('/events');
      const data = await res.json() as Evt[];
      if (data.length === 0) {
        list.innerHTML = '<p class="loading-msg">No upcoming events scheduled. Check back soon.</p>';
        return;
      }
      list.innerHTML = data.map(ev => `
        <div class="event-row">
          <div class="event-date-block">
            <div class="event-month">${fmtMonth(ev.date)}</div>
            <div class="event-day">${fmtDay(ev.date)}</div>
          </div>
          <div class="event-info">
            <h3>${ev.title}</h3>
            <p class="event-meta">${ev.time} · ${ev.location}</p>
            <p class="event-desc">${ev.description}</p>
          </div>
        </div>
      `).join('');
    } catch {
      list.innerHTML = '<p class="loading-msg" style="color:#b91c1c">Could not load events. Please try again later.</p>';
    }
  }

  loadEvents();
</script>

<script is:inline>
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>

<style>
  .loading-msg { font-size: 0.9rem; color: var(--text-secondary); }
</style>
